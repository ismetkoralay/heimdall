# Port the Http server listens on. Must be an integer in [1, 65535].
PORT=8080

# Log verbosity: debug, info, warn, or error. Empty defaults to info; any
# other value fails startup.
LOG_LEVEL=info

# Path to the model-provider map.
# This has to be defined.
# The file defined in the path must exist and must be valid.
# The value assumes VSCode's debug working directory.
# compose.yml sets its own value for containerized version.
MODEL_CONFIG_PATH="../../config/models.yaml"

# Directory containing the goose migration files, passed to goose.Up as-is.
# Empty defaults to "migrations", resolved relative to the process's working
# directory.
# compose.yml sets its own absolute value for the containerized version.
DB_MIGRATIONS_DIR=migrations

# Host of the postgres db
DB_HOST=postgres
# Username for the db connection
DB_USER=heimdall
# Port of the postgres db
DB_PORT=5432
# Password for the db connection
DB_PASSWORD=password
# Name of the database in the postgres
DB_NAME=heimdall
# SSL mode
DB_SSL_MODE=disable
# Whether to apply postgres migrations.
DB_APPLY_MIGRATIONS=false

# Generated admin token per environment to authenticate admin/* endpoints.
HEIMDALL_ADMIN_KEY=<generated once>