# Port the Http server listens on. Must be an integer in [1, 65535].
PORT=8080

# Log verbosity: debug, info, warn, or error. Empty defaults to info; any
# other value fails startup.
LOG_LEVEL=info

# Path to the model-provider map.
# This has to be defined.
# The file defined in the path must exist and must be valid.
# The value assumes VSCode's debug working directory.
# compose.yml sets its own value for containerized version.
MODEL_CONFIG_PATH="../../config/models.yaml"